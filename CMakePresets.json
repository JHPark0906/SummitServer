{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs",
      "displayName": "Visual Studio 2026 (x64)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs"
    },
    {
      "name": "ninja-debug",
      "displayName": "MSVC Debug (Developer PowerShell, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-debug",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl", "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ninja-release",
      "displayName": "MSVC Release (Developer PowerShell, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-release",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl", "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "vs", "configuration": "Debug" },
    { "name": "release", "configurePreset": "vs", "configuration": "Release" },
    { "name": "ninja-debug", "configurePreset": "ninja-debug" },
    { "name": "ninja-release", "configurePreset": "ninja-release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "vs", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "vs", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "ninja-debug", "configurePreset": "ninja-debug", "output": { "outputOnFailure": true } },
    { "name": "ninja-release", "configurePreset": "ninja-release", "output": { "outputOnFailure": true } }
  ]
}
